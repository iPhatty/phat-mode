{
  "name": "phat-mode",
  "version": "0.1.0",
  "private": true,
  "description": "Durable GitHub issue-to-pull-request agent built on Pi Durable",
  "type": "module",
  "bin": {
    "phat-mode": "./src/cli.ts"
  },
  "scripts": {
    "phat-mode": "node src/cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test --test-reporter=spec 'test/**/*.test.ts'",
    "check": "npm run typecheck && npm test"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@earendil-works/chord": "1.3.0",
    "@earendil-works/pi-ai": "1.3.0",
    "@earendil-works/pi-durable": "1.3.0"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "typescript": "7.0.2"
  }
}
